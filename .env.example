# 部署者私钥。用一个**全新**钱包 —— 这把钥匙控制整个观星台（阶段、baseURI、版税）。
# 它只需要一点点 gas；献纳的钱不经过它，直接进金库。
PRIVATE_KEY=0x...

# 献纳收款地址。写死进合约，部署之后谁也改不了 —— 包括合约 owner。
# 不填就用这个默认值。
TREASURY=0x…你的收款地址

# 星座铭刻价（星屑永远免费）
INSCRIPTION_PRICE=0.0088

# 二级市场版税，500 = 5%。收款人默认也是 TREASURY。
ROYALTY_BPS=500

# 站点根地址，不带结尾斜杠。og:image / 分享页 / sitemap 都从它拼出来。
#   SITE=https://xxx.pages.dev npm run site
SITE=https://xxx.pages.dev

# baseURI —— tokenURI = BASE + tokenId，**必须以斜杠结尾**。
# 两种选择：
#   1) 跟站点同域：https://xxx.pages.dev/metadata/   （简单，但域名没了元数据就没了）
#   2) IPFS：ipfs://bafyXXXX/                        （推荐，31MB，免费额度足够）
BASE=https://xxx.pages.dev/metadata/

# Pinata 的 API JWT（免费档够用）。只勾 pinFileToIPFS 权限：
# 万一泄漏，别人只能往你账号里塞新文件，删不掉也管不了已有的 pin。
PINATA_JWT=

# Filebase（免费档 5GB）。桶必须建成 IPFS 类型，
# 上传 CAR 时带 import=car，根 CID 才会原样保留。
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=
