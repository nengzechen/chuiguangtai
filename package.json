{
  "name": "nft-mint",
  "version": "1.0.0",
  "scripts": {
    "test": "hardhat test",
    "build": "hardhat compile",
    "metadata": "node scripts/gen-metadata.js",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network robinhood",
    "inspect": "hardhat run scripts/inspect.js --network localhost",
    "web": "node scripts/serve.js",
    "fund": "hardhat run scripts/fund.js --network localhost",
    "accounts": "hardhat run scripts/accounts.js --network localhost",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "fill": "hardhat run scripts/fill.js --network localhost",
    "smoke": "node scripts/smoke.js",
    "smoke:web": "node scripts/smoke.js --web",
    "check": "npm test && npm run smoke",
    "font": "node scripts/subset-font.js",
    "site": "node scripts/site-url.js",
    "whoami": "hardhat run scripts/whoami.js",
    "preflight": "node scripts/preflight.js",
    "release": "npm run metadata && npm run site && npm run font && npm run stamp && npm run smoke && npm run preflight",
    "stamp": "node scripts/stamp.js",
    "ipfs": "node scripts/ipfs-pack.js",
    "setbase": "hardhat run scripts/set-base-uri.js",
    "ipfs:upload": "node scripts/ipfs-upload.js",
    "ipfs:pin": "node scripts/ipfs-pin.js",
    "filebase": "node scripts/filebase-upload.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "ERC-721 mint dApp for Robinhood Chain",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.0",
    "htmlparser2": "^12.0.0",
    "ipfs-car": "^3.1.0",
    "subset-font": "^2.5.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@openzeppelin/contracts": "^5.6.1"
  }
}
